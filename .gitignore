# ============================================================
# voilut —— Git 忽略规则
# ============================================================
# 组织顺序：
#   1. 构建 / 运行产物
#   2. 构建系统（CMake / Ninja）
#   3. 编译器与工具链产物
#   4. 编辑器 / IDE
#   5. 操作系统
#   6. 依赖与第三方
#   7. 临时文件 / 日志 / core dump
# ============================================================

# ------------------------------------------------------------
# 1. 构建 / 运行产物
# ------------------------------------------------------------
/build/
/build-*/
cmake-build-*/
/out/
# ImGui 运行时写出的窗口布局
/imgui.ini
/screenshot_*.ppm

# ------------------------------------------------------------
# 2. 构建系统
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Testing/
compile_commands.json
CMakeUserPresets.json
*.ninja
.ninja_deps
.ninja_log
vcpkg_installed/
.conan/

# ------------------------------------------------------------
# 3. 编译器与工具链产物
# ------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.d
*.gch
*.pch
*.pdb
*.ilk
*.exp

# ------------------------------------------------------------
# 4. 编辑器 / IDE
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.idea/
*.iml
*.suo
*.user
*.swp
*.swo
*~
tags
.cache/
.clangd/

# ------------------------------------------------------------
# 5. 操作系统
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# 6. 依赖与第三方
# ------------------------------------------------------------
# Dawn / GDCM / imgui 合计约 820 MB，由 scripts/*.sh 获取，不入库。
/third_party/

# ------------------------------------------------------------
# 7. 临时文件 / 日志 / core dump
# ------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*.log
logs/
# 注意：绝不能写成裸 `core` —— 它会把 core/ 源码目录整个忽略掉。
core.[0-9]*
core-*.dmp
vgcore.*

# ------------------------------------------------------------
# 8. 医学影像数据（可能包含患者隐私，默认不入库）
# ------------------------------------------------------------
# 如确需测试样本，请使用彻底去标识化的数据，并用 `git add -f` 显式加入。
*.dcm
*.dicom
*.ima
DICOMDIR
*.nii
*.nii.gz
*.tif
*.tiff

# ------------------------------------------------------------
# 9. 明确保留
# ------------------------------------------------------------
!README.md
!CMakeLists.txt
!shaders/*.wgsl
